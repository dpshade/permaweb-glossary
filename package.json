{
  "name": "permaweb-glossary-search",
  "version": "1.0.0",
  "description": "A lightweight client-side search for the Permaweb Glossary using FlexSearch",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:vercel": "astro build",
    "preview": "astro preview",
    "deploy": "./scripts/deploy-production.sh",
    "deploy:preview": "./scripts/deploy-preview.sh",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:preview": "vercel",
    "sync": "bun run scripts/sync-permaweb-llm-data.js",
    "sync:dev": "bun run sync && bun run dev"
  },
  "keywords": [
    "search",
    "glossary",
    "permaweb",
    "javascript",
    "flexsearch"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "bun": "^1.0.20",
    "permaweb-deploy": "^1.1.10"
  },
  "engines": {
    "node": ">=16.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dpshade/permaweb-glossary"
  },
  "dependencies": {
    "astro": "^5.11.1",
    "dotenv": "^16.4.7",
    "flexsearch": "^0.8.205"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleFileExtensions": ["js", "json", "jsx"]
  }
}
